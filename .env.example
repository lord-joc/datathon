# Kopiraj u .env i zamijeni SVE vrijednosti "promijeni_me".
# Lozinke generiraj samo od heks znakova (sigurno u URL-u):
#   py -c "import secrets; print(secrets.token_hex(24))"
# .env se NIKAD ne commita.

APP_ENV=development
LOG_LEVEL=INFO

POSTGRES_DB=prostoriq
POSTGRES_USER=prostoriq_owner
POSTGRES_PASSWORD=promijeni_me
API_DB_PASSWORD=promijeni_me
PIPELINE_DB_PASSWORD=promijeni_me

APP_HMAC_SECRET=promijeni_me

# Lokalno ":80". Na serveru javna domena, npr. prostoriq.example.hr (Caddy sam dobiva TLS).
SITE_ADDRESS=:80
