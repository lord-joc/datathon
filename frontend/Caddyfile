# ProstorIQ web server: static SPA + same-origin reverse proxy to the API.
# SITE_ADDRESS=":80" locally (plain HTTP on localhost). In production set it to the
# public domain (e.g. "prostoriq.example.hr") and Caddy obtains a TLS certificate itself.
{
	admin off
	servers {
		trusted_proxies static private_ranges
	}
}

{$SITE_ADDRESS::80} {
	# The basemap is already compressed and is read with HTTP range requests: never re-encode it.
	@compressible not path /tiles/*
	encode @compressible zstd gzip

	# upgrade-insecure-requests only over HTTPS: on plain-HTTP localhost WebKit would rewrite
	# every asset URL to https:// and the app would not load (found by the iPhone e2e run).
	map {scheme} {csp_upgrade} {
		https "; upgrade-insecure-requests"
		default ""
	}

	header {
		# Master prompt §8. MapLibre needs blob: workers and data:/blob: images (sprites, icons);
		# tiles are served from this origin. Our own assets are never inlined (assetsInlineLimit: 0).
		# 'unsafe-inline' styles are needed for React style props and MapLibre; scripts stay strict.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; child-src blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'{csp_upgrade}"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		X-Frame-Options "DENY"
		-Server
	}

	# HSTS only when served over HTTPS (production domain).
	@https protocol https
	header @https Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# Protomaps PMTiles extract for Zagreb (mounted from data/basemap, not in the image).
	handle /tiles/* {
		root * /srv
		header Cache-Control "public, max-age=86400"
		file_server
	}

	handle /api/* {
		reverse_proxy api:8000 {
			header_up X-Request-ID {http.request.uuid}
		}
	}

	handle {
		root * /srv

		# Hashed build assets never change.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		@html path / /index.html
		header @html Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format json
	}
}
